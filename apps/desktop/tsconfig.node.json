{
  "extends": "klarity/tsconfig/app",
  "compilerOptions": {
    // electron-vite bundles the main process and the preload, so imports resolve like a bundler's.
    "lib": ["ES2023"],
    "types": ["node", "vite/client"]
  },
  "include": ["src/main", "src/preload", "src/bridge", "tests", "*.config.ts"]
}
