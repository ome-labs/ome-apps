{
  "name": "@ome-labs/brand",
  "version": "0.0.0",
  "private": true,
  "description": "Ome brand assets: logo, mark, app icons, fonts, textures, pixel objects and illustrations",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    "./web": "./src/web/index.ts",
    "./native": "./src/native/index.ts",
    "./fonts.css": "./src/web/fonts.css",
    "./manifest": "./src/manifest.ts",
    "./assets/*": "./assets/*",
    "./fonts/*": "./assets/fonts/*"
  },
  "scripts": {
    "build": "node scripts/generate.ts",
    "export": "node scripts/export.ts",
    "lint": "oxlint --deny-warnings .",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@ome-labs/tokens": "workspace:*"
  },
  "devDependencies": {
    "@svgr/core": "8.1.0",
    "@svgr/plugin-jsx": "8.1.0",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "jsdom": "catalog:",
    "klarity": "catalog:",
    "oxlint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:",
    "react-native-svg": "catalog:",
    "sharp": "0.35.5",
    "svgo": "4.1.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-native": "catalog:",
    "react-native-svg": "catalog:"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    },
    "react-native-svg": {
      "optional": true
    }
  }
}
