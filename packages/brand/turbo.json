{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "typecheck": {
      "dependsOn": ["build", "^build", "^typecheck"]
    },
    "test": {
      "dependsOn": ["build", "^build"],
      "outputs": []
    },
    "build": {
      "outputs": ["src/generated/**"]
    }
  }
}
