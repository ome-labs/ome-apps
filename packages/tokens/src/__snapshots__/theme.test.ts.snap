  --height-control-md: 32px;
  --height-control-lg: 40px;
  --ease-*: initial;
  --ease-standard: cubic-bezier(0.2, 0, 0, 1);
  --ease-emphasized: cubic-bezier(0.16, 1, 0.3, 1);
  --transition-duration-instant: 0ms;
  --transition-duration-fast: 120ms;
  --transition-duration-base: 200ms;
  --transition-duration-slow: 320ms;
  --transition-duration-scene: 600ms;
  --breakpoint-*: initial;
  --breakpoint-tablet: 834px;
  --breakpoint-desktop: 1440px;
  --breakpoint-wide: 1920px;
}

@utility type-display-hero {
  font-family: var(--font-display);
  font-size: var(--text-display-hero);
  line-height: var(--text-display-hero--line-height);
  letter-spacing: var(--text-display-hero--letter-spacing);
  font-weight: var(--text-display-hero--font-weight);
}
@utility type-display-xl {
  font-family: var(--font-display);
  font-size: var(--text-display-xl);
  line-height: var(--text-display-xl--line-height);
  letter-spacing: var(--text-display-xl--letter-spacing);
  font-weight: var(--text-display-xl--font-weight);
}
@utility type-display-l {
  font-family: var(--font-display);
  font-size: var(--text-display-l);
  line-height: var(--text-display-l--line-height);
  letter-spacing: var(--text-display-l--letter-spacing);
  font-weight: var(--text-display-l--font-weight);
}
@utility type-display-m {
  font-family: var(--font-display);
  font-size: var(--text-display-m);
  line-height: var(--text-display-m--line-height);
  letter-spacing: var(--text-display-m--letter-spacing);
  font-weight: var(--text-display-m--font-weight);
}
@utility type-display-s {
  font-family: var(--font-display);
  font-size: var(--text-display-s);
  line-height: var(--text-display-s--line-height);
  letter-spacing: var(--text-display-s--letter-spacing);
  font-weight: var(--text-display-s--font-weight);
}
@utility type-heading-xl {
  font-family: var(--font-sans);
  font-size: var(--text-heading-xl);
  line-height: var(--text-heading-xl--line-height);
  letter-spacing: var(--text-heading-xl--letter-spacing);
  font-weight: var(--text-heading-xl--font-weight);
}
@utility type-heading-l {
  font-family: var(--font-sans);
  font-size: var(--text-heading-l);
  line-height: var(--text-heading-l--line-height);
  letter-spacing: var(--text-heading-l--letter-spacing);
  font-weight: var(--text-heading-l--font-weight);
}
@utility type-heading-m {
  font-family: var(--font-sans);
  font-size: var(--text-heading-m);
  line-height: var(--text-heading-m--line-height);
  letter-spacing: var(--text-heading-m--letter-spacing);
  font-weight: var(--text-heading-m--font-weight);
}
@utility type-heading-s {
  font-family: var(--font-sans);
  font-size: var(--text-heading-s);
  line-height: var(--text-heading-s--line-height);
  letter-spacing: var(--text-heading-s--letter-spacing);
  font-weight: var(--text-heading-s--font-weight);
}
@utility type-body-l {
  font-family: var(--font-sans);
  font-size: var(--text-body-l);
  line-height: var(--text-body-l--line-height);
  letter-spacing: var(--text-body-l--letter-spacing);
  font-weight: var(--text-body-l--font-weight);
}
@utility type-body-m {
  font-family: var(--font-sans);
  font-size: var(--text-body-m);
  line-height: var(--text-body-m--line-height);
  letter-spacing: var(--text-body-m--letter-spacing);
  font-weight: var(--text-body-m--font-weight);
}
@utility type-body-s {
  font-family: var(--font-sans);
  font-size: var(--text-body-s);
  line-height: var(--text-body-s--line-height);
  letter-spacing: var(--text-body-s--letter-spacing);
  font-weight: var(--text-body-s--font-weight);
}
@utility type-label-m {
  font-family: var(--font-sans);
  font-size: var(--text-label-m);
  line-height: var(--text-label-m--line-height);
  letter-spacing: var(--text-label-m--letter-spacing);
  font-weight: var(--text-label-m--font-weight);
}
@utility type-label-s {
  font-family: var(--font-sans);
  font-size: var(--text-label-s);
  line-height: var(--text-label-s--line-height);
  letter-spacing: var(--text-label-s--letter-spacing);
  font-weight: var(--text-label-s--font-weight);
}
@utility type-caption {
  font-family: var(--font-sans);
  font-size: var(--text-caption);
  line-height: var(--text-caption--line-height);
  letter-spacing: var(--text-caption--letter-spacing);
  font-weight: var(--text-caption--font-weight);
}
@utility type-overline {
  font-family: var(--font-mono);
  font-size: var(--text-overline);
  line-height: var(--text-overline--line-height);
  letter-spacing: var(--text-overline--letter-spacing);
  font-weight: var(--text-overline--font-weight);
  text-transform: uppercase;
}
@utility type-mono-m {
  font-family: var(--font-mono);
  font-size: var(--text-mono-m);
  line-height: var(--text-mono-m--line-height);
  letter-spacing: var(--text-mono-m--letter-spacing);
  font-weight: var(--text-mono-m--font-weight);
}
@utility type-mono-s {
  font-family: var(--font-mono);
  font-size: var(--text-mono-s);
  line-height: var(--text-mono-s--line-height);
  letter-spacing: var(--text-mono-s--letter-spacing);
  font-weight: var(--text-mono-s--font-weight);
}
@utility type-numeric-l {
  font-family: var(--font-mono);
  font-size: var(--text-numeric-l);
  line-height: var(--text-numeric-l--line-height);
  letter-spacing: var(--text-numeric-l--letter-spacing);
  font-weight: var(--text-numeric-l--font-weight);
}
@utility type-numeric-m {
  font-family: var(--font-mono);
  font-size: var(--text-numeric-m);
  line-height: var(--text-numeric-m--line-height);
  letter-spacing: var(--text-numeric-m--letter-spacing);
  font-weight: var(--text-numeric-m--font-weight);
}

@utility h-control-* {
  height: --value(--height-control-*);
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}
"
`;
