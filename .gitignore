# Dependencies
node_modules/
.pnpm-store/

# Build output and caches
# (generated TypeScript from @ome-labs/brand and others)
packages/*/src/generated/
# Figma art masters downloaded by @ome-labs/brand's export script
.masters/
dist/
build/
out/
.next/
.astro/
.vercel/
.turbo/
*.tsbuildinfo
coverage/

# Expo and React Native: generated native projects and local state
.expo/
expo-env.d.ts
# Uniwind writes its theme types when Metro starts
uniwind-types.d.ts
apps/*/ios/
apps/*/android/
*.jks
*.p8
*.p12
*.mobileprovision

# Desktop (Electron): packaged apps, and Playwright results
apps/desktop/release/
test-results/
playwright-report/

# Environment and secrets
.env
.env.*
!.env.example
*.pem
*.key

# Local tooling state
.claude/settings.local.json
lefthook-local.yml

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Editors and OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp

# Local plans and research, never a build input
research/
