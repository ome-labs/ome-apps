{
  "name": "ome-apps",
  "private": true,
  "description": "Ome's apps: desktop, mobile and the website, with their shared UI",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "dev": "turbo run dev",
    "format": "oxfmt --write . && turbo run format",
    "format:check": "oxfmt --check . && turbo run format:check",
    "kit": "turbo run dev --filter=@ome-labs/kit",
    "lint": "oxlint --deny-warnings . && turbo run lint",
    "lint:fix": "oxlint --fix .",
    "prepare": "lefthook install",
    "test": "turbo run test",
    "typecheck": "tsc -p tsconfig.json && turbo run typecheck"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@types/node": "catalog:",
    "klarity": "catalog:",
    "lefthook": "2.2.2",
    "oxfmt": "0.78.0",
    "oxlint": "catalog:",
    "turbo": "2.11.10",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.18.0"
}
